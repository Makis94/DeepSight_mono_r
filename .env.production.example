# Production secrets for the VM's docker-compose.prod.yml stack (postgres/caddy/api/bot/
# the six workers). Copy to `.env` on the VM (NEVER commit the real file — already covered
# by .gitignore's `.env` / `.env.*` / `!.env.example` rules, but this one is an extra
# reminder since it lives at repo root, not under an app's own directory).
#
# Do not paste real values into chat, issues, or commits — set them directly on the VM
# (e.g. via `nano .env` over SSH) or through your host's secret manager.

# --- Infra ---
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Domain apps/api is reverse-proxied on by Caddy (see Caddyfile) — e.g. api.example.com.
# Must be a real DNS A record pointing at this VM's public IP before first `docker compose
# up`, or Caddy's ACME (Let's Encrypt) HTTPS issuance will fail.
API_DOMAIN=
# Email Let's Encrypt uses for expiry/problem notices about the API_DOMAIN certificate.
ACME_EMAIL=

# --- Shared across api/bot/worker ---
NODE_ENV=production
LOG_LEVEL=info
# Production @Deep_sight_bot token — same one apps/api uses to verify Telegram auth
# payloads/initData (see packages/shared) and apps/bot uses to talk to the Bot API.
BOT_TOKEN=
# https://api.example.com — same value as API_DOMAIN, with scheme. NowPayments POSTs IPN
# callbacks here; the bot's /subscribe command also points NowPayments at this.
PUBLIC_API_URL=

# --- apps/api only ---
# Generate with: openssl rand -base64 32
JWT_SECRET=
# Generate with: openssl rand -base64 32 (must differ from JWT_SECRET)
ADMIN_JWT_SECRET=
ADMIN_USERNAME=
# bcrypt hash only — generate on the VM (or locally) with:
#   docker compose -f docker-compose.prod.yml run --rm api pnpm --filter @hypertracker/api hash-admin-password '<password>'
ADMIN_PASSWORD_HASH=
# Exact origin apps/admin is served from on Vercel, e.g. https://admin.example.com — must
# be an exact match (scheme+host), used as the credentialed CORS origin for /admin/* routes.
ADMIN_ORIGIN=

# --- NowPayments (live account, NOT sandbox — see nowpayments-client.ts in
# apps/api / apps/bot / apps/worker) ---
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io

# --- apps/worker: coin-registry-sync ---
USE_REAL_CMC=true
CMC_API_KEY=

# --- apps/worker: deposit-watcher ---
USE_REAL_ARBITRUM=true
ARBITRUM_RPC_URL=
USE_REAL_HYPEREVM_CCTP=true
DEPOSIT_MIN_NOTIONAL_USD=5000

# --- apps/worker: market-watcher ---
MARKET_TRADE_MIN_NOTIONAL_USD=10000
MARKET_TWAP_MIN_NOTIONAL_USD=10000

# --- apps/worker: subscription-watcher ---
# SUBSCRIPTION_POLL_INTERVAL_MS=300000
