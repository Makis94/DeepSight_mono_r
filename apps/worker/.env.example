NODE_ENV=development
DATABASE_URL=postgres://hypertracker:hypertracker@localhost:5432/hypertracker
LOG_LEVEL=info
# HEARTBEAT_PORT is set per-process by the dev:* scripts (9101/9102/9103/9104) since all
# four watchers share this file in local dev. In production each watcher runs as its own
# process/container with its own env, so set HEARTBEAT_PORT there directly.

# market-watcher: floor below which a trade isn't even written as a market_trade event.
# Should stay <= the lowest threshold preset selectable in apps/web (see packages/shared
# TRADE_THRESHOLD_PRESETS) or that preset would never see any trades.
MARKET_TRADE_MIN_NOTIONAL_USD=10000

# coin-registry-sync: flips between the static top-30 placeholder list and a real call to
# CoinMarketCap's listings/latest (see apps/worker/src/coin-registry-sync/cmc-client.ts).
# Leave USE_REAL_CMC=false with no key set to run on the placeholder list.
USE_REAL_CMC=false
# CMC_API_KEY=

# deposit-watcher: floor below which a deposit isn't even written as a global_deposit event.
# Should stay <= the lowest threshold preset selectable in apps/web (see packages/shared
# DEPOSIT_THRESHOLD_PRESETS, currently $5k/$100k/$500k/$1m) or that preset would never see
# any deposits.
DEPOSIT_MIN_NOTIONAL_USD=5000

# deposit-watcher: two independent on-chain sources, either/both/neither can be enabled (see
# deposit-monitoring-architecture skill). Like USE_REAL_GRAPH before it, leaving both false
# just runs deposit-watcher idle (logs this clearly on startup) rather than crashing or
# pretending to work — there's no meaningful mock for "which deposits happened".
#
# Legacy Bridge2 contract on Arbitrum (apps/worker/src/deposit-watcher/sources/
# arbitrum-bridge2-deposit-source.ts) — now a minority of deposit volume (Hyperliquid's own
# docs: this path holds <10% of USDC supply on HyperCore), but still real. Needs a real
# Arbitrum RPC provider (Alchemy/Infura/QuickNode free tier is enough) — the public
# arb1.arbitrum.io/rpc endpoint is too rate-limited for continuous log polling.
USE_REAL_ARBITRUM=false
# ARBITRUM_RPC_URL=

# CCTP-forwarder contract on HyperEVM (apps/worker/src/deposit-watcher/sources/
# hyperevm-cctp-forwarder-deposit-source.ts) — the now-dominant deposit path (Circle CCTP,
# covers Arbitrum/Base/Ethereum/Polygon/etc. as source chains). No API key or third-party RPC
# needed — uses Hyperliquid's own public HyperEVM RPC, hardcoded in that file.
USE_REAL_HYPEREVM_CCTP=false

# subscription-watcher: reconciliation fallback (polls stuck payments) + expiry sweep.
# NOWPAYMENTS_API_KEY is also needed here (in addition to apps/api) since this worker polls
# NowPayments directly rather than relying solely on apps/api's webhook.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io
# SUBSCRIPTION_POLL_INTERVAL_MS=300000
