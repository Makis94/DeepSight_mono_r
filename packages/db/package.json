    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@hypertracker/eslint-config": "workspace:*",
    "@hypertracker/tsconfig": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
